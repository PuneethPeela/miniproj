// ── Smart Canteen Ordering & Queue Management System ─────────────────────
// Prisma schema for Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  KITCHEN_STAFF
  MANAGER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  PICKED_UP
  CANCELLED
}

enum QueueStage {
  WAITING
  IN_KITCHEN
  READY_FOR_PICKUP
}

// ── Models ───────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  orders            Order[]
  stockRequests     StockRequest[] @relation("StockRequester")
  reviewedRequests  StockRequest[] @relation("Reviewer")

  @@map("users")
}

model MenuItem {
  id               String   @id @default(cuid())
  name             String
  description      String?
  price            Float
  category         String
  imageUrl         String?  @map("image_url")
  available        Boolean  @default(true)
  quantityAvailable Int     @default(50) @map("quantity_available") // inventory stock
  avgPrepSeconds   Int      @default(300) @map("avg_prep_seconds") // avg prep time in seconds
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt      @map("updated_at")

  orderItems    OrderItem[]
  stockRequests StockRequest[]

  @@map("menu_items")
}

model Order {
  id          String      @id @default(cuid())
  tokenNumber Int         @unique @default(autoincrement()) @map("token_number")
  status      OrderStatus @default(PENDING)
  totalAmount Float       @map("total_amount")
  estimatedAt DateTime?   @map("estimated_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt      @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  items       OrderItem[]
  queueEntry  QueueEntry?

  @@map("orders")
}

model OrderItem {
  id       String @id @default(cuid())
  quantity Int

  orderId    String   @map("order_id")
  order      Order    @relation(fields: [orderId], references: [id])

  menuItemId String   @map("menu_item_id")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@map("order_items")
}

model QueueEntry {
  id                String      @id @default(cuid())
  stage             QueueStage  @default(WAITING)
  positionInQueue   Int         @map("position_in_queue")
  estimatedReadyAt  DateTime?   @map("estimated_ready_at")
  enteredStageAt    DateTime    @default(now()) @map("entered_stage_at")

  orderId String @unique @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("queue_entries")
}

model QueueStatus {
  id            String   @id @default(cuid())
  currentToken  Int      @default(0) @map("current_token")
  estimatedWait Int      @default(0) @map("estimated_wait") // minutes
  activeOrders  Int      @default(0) @map("active_orders")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("queue_status")
}

model StockRequest {
  id            String    @id @default(cuid())
  menuItemId    String
  menuItem      MenuItem  @relation(fields: [menuItemId], references: [id])
  requestedBy   String
  requester     User      @relation("StockRequester", fields: [requestedBy], references: [id])
  quantity      Int
  reason        String?
  status        String    @default("PENDING")
  reviewedBy    String?
  reviewer      User?     @relation("Reviewer", fields: [reviewedBy], references: [id])
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([status])
  @@index([menuItemId])
  @@map("stock_requests")
}
